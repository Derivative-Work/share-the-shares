# Large files: excluded from git, hashed in MANIFEST.sha256, the irreplaceable ones published as a GitHub Release.
audio/track/
audio/stems/
audio/master/
renders/
takes/
reference/stills/
*.wav
*.mp3
*.flac
*.zip
*.blend
*.blend1
*.mp4
*.mov
*.mkv
*.webm
transcripts/

# Reference material: never published, never hashed into the manifest.
reference/inspiration/

# Regenerable: never archived; versions and regen commands are logged instead.
frames/
**/frames/
cache/
**/__pycache__/
.venv/
venv/
node_modules/
models/
*.pt
*.safetensors

# Downloaded source art (public domain; listed with URLs in each sources.tsv, hashed in the manifest).
assets/engravings/source/
reference/certificates/*.jpg
# Ink pieces and certificate prints regenerate from scripts/ink_extract.py and scripts/certificate.py.
assets/engravings/ink/
# Frame sequences of any name (frames_<view>/, frames_cast_<view>/): never archived, regenerate from the logged commands.
**/frames_*/
# Superseded renders (hashed in the manifest; frame sequences are skipped by scripts/manifest.sh).
archive/renders/
# Puppet layers regenerate from the committed masks (scripts/puppet_build.py).
assets/puppets/*/layers/
renders/c4/graphics/

# deliverables: the binaries stay out of git (in MANIFEST.sha256); their .json indexes are tracked
deliverables/**/*.png
deliverables/**/*.pdf
# the call page with its backgrounds inlined (scripts/build_call_page.py); the source is apps/call_page/index.html
deliverables/call_page/*.html
